index 0000000000..f59f096a70
--- /dev/null
+++ b/apps/server/src/agent/AgentService.test.ts
@@ -0,0 +1,310 @@
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { assert, describe, it } from "@effect/vitest";
+import {
+  AgentDefinition,
+  AgentId,
+  ProviderDriverKind,
+  ProviderInstanceId,
+  type ServerProvider,
+} from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Option from "effect/Option";
+import * as Path from "effect/Path";
+import * as Schema from "effect/Schema";
+
+import { getAgentDefinition, listAgentSummaries, resolveModelForAgent } from "./AgentService.ts";
+
+/** An agent file: frontmatter lines, then the body that becomes its instructions. */
+const agentFile = (frontmatter: ReadonlyArray<string>, body: string) =>
+  ["---", ...frontmatter, "---", "", body].join("\n");
+
+const writeFiles = Effect.fn("writeFiles")(function* (root: string, files: Record<string, string>) {
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  for (const [relativePath, contents] of Object.entries(files)) {
+    const filePath = path.join(root, relativePath);
+    yield* fs.makeDirectory(path.dirname(filePath), { recursive: true });
+    yield* fs.writeFileString(filePath, contents);
+  }
+});
+
+const decodeAgentDefinition = Schema.decodeUnknownSync(AgentDefinition);
+
+const definition = (fields: Record<string, unknown>) =>
+  decodeAgentDefinition({
+    id: "reviewer",
+    name: "Reviewer",
+    description: "Reviews diffs.",
+    instructions: "Review the diff.",
+    ...fields,
+  });
+
+const provider = (
+  instanceId: string,
+  driver: string,
+  slugs: ReadonlyArray<string>,
+): ServerProvider => ({
+  instanceId: ProviderInstanceId.make(instanceId),
+  driver: ProviderDriverKind.make(driver),
+  enabled: true,
+  installed: true,
+  version: "test",
+  status: "ready",
+  auth: { status: "authenticated" },
+  checkedAt: "2026-10-10T00:00:00.000Z",
+  models: slugs.map((slug) => ({ slug, name: slug, isCustom: false, capabilities: null })),
+  slashCommands: [],
+  skills: [],
+});
+
+it.layer(NodeServices.layer)("agent discovery", (it) => {
+  it.effect("discovers agents from every agent location and AGENTS.md", () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-agents-locations-" });
+      yield* writeFiles(root, {
+        ".agents/planner.agent.md": agentFile(
+          ["id: planner", "name: Planner", "description: Plans work."],
+          "Plan it.",
+        ),
+        ".agents/reviewer.md": agentFile(
+          ["id: reviewer", "name: Reviewer", "description: Reviews work."],
+          "Review it.",
+        ),
+        ".github/agents/tester.agent.md": agentFile(
+          ["id: tester", "name: Tester", "description: Tests work."],
+          "Test it.",
+        ),
+        ".github/agents/docs.md": agentFile(
+          ["id: docs", "name: Docs", "description: Writes docs."],
+          "Document it.",
+        ),
+        "AGENTS.md": agentFile(
+          ["id: coordinator", "name: Coordinator", "description: Coordinates work."],
+          "Coordinate it.",
+        ),
+      });
+
+      const agents = yield* listAgentSummaries(root);
+
+      assert.deepEqual(agents.map((agent) => agent.id).toSorted(), [
+        "coordinator",
+        "docs",
+        "planner",
+        "reviewer",
+        "tester",
+      ]);
+    }),
+  );
+
+  it.effect("parses every frontmatter field and keeps the body as instructions", () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-agents-fields-" });
+      yield* writeFiles(root, {
+        ".agents/full.agent.md": agentFile(
+          [
+            "id: full",
+            "name: Full agent",
+            "description: Uses every field.",
+            "model:",
+            "  provider: claudeAgent",
+            "  model: claude-haiku-4-5",
+            "tier: economy",
+            "tools:",
+            "  allow: [read, search]",
+            "  deny: [shell]",
+            "canDelegateTo: [planner]",
+          ],
+          "Be exhaustive.\n\nKeep it short.",
+        ),
+      });
+
+      const agent = Option.getOrUndefined(yield* getAgentDefinition(AgentId.make("full"), root));
+
+      assert.deepEqual(agent, {
+        id: AgentId.make("full"),
+        name: "Full agent",
+        description: "Uses every field.",
+        model: { instanceId: ProviderInstanceId.make("claudeAgent"), model: "claude-haiku-4-5" },
+        tier: "economy",
+        canDelegateTo: [AgentId.make("planner")],
+        instructions: "Be exhaustive.\n\nKeep it short.",
+      });
+      assert.deepEqual(yield* listAgentSummaries(root), [
+        {
+          id: AgentId.make("full"),
+          name: "Full agent",
+          description: "Uses every field.",
+          tier: "economy",
+          model: { instanceId: ProviderInstanceId.make("claudeAgent"), model: "claude-haiku-4-5" },
+        },
+      ]);
+    }),
+  );
+
+  it.effect("leaves the tier unset and defaults delegation to empty", () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-agents-defaults-" });
+      yield* writeFiles(root, {
+        ".github/agents/minimal.agent.md": agentFile(
+          ["id: minimal", "name: Minimal", "description: Bare minimum."],
+          "Do the task.",
+        ),
+      });
+
+      const agent = Option.getOrUndefined(yield* getAgentDefinition(AgentId.make("minimal"), root));
+
+      assert.deepEqual(agent, {
+        id: AgentId.make("minimal"),
+        name: "Minimal",
+        description: "Bare minimum.",
+        canDelegateTo: [],
+        instructions: "Do the task.",
+      });
+    }),
+  );
+
+  it.effect("skips guidance and invalid definitions without hiding valid agents", () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-agents-invalid-" });
+      yield* writeFiles(root, {
+        "AGENTS.md": "# Project guidance\n\nNo frontmatter here.",
+        ".agents/notes.md": "Just notes.",
+        ".agents/bad-id.agent.md": agentFile(
+          ["id: Bad Id", "name: Bad id", "description: Not kebab case."],
+          "Body.",
+        ),
+        ".agents/bad-tier.agent.md": agentFile(
+          ["id: bad-tier", "name: Bad tier", "description: Unknown tier.", "tier: fast"],
+          "Body.",
+        ),
+        ".agents/empty-body.agent.md": agentFile(
+          ["id: empty-body", "name: Empty body", "description: No instructions."],
+          "",
+        ),
+        ".agents/broken.agent.md": "---\nid: [unclosed\n---\n\nBody.",
+        ".agents/valid.agent.md": agentFile(
+          ["id: valid", "name: Valid", "description: Parses fine."],
+          "Body.",
+        ),
+      });
+
+      const agents = yield* listAgentSummaries(root);
+
+      assert.deepEqual(
+        agents.map((agent) => agent.id),
+        ["valid"],
+      );
+    }),
+  );
+
+  it.effect("keeps the first definition when two locations define the same id", () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-agents-duplicate-" });
+      yield* writeFiles(root, {
+        ".agents/reviewer.agent.md": agentFile(
+          ["id: reviewer", "name: Local reviewer", "description: Local copy."],
+          "Local.",
+        ),
+        "AGENTS.md": agentFile(
+          ["id: reviewer", "name: Root reviewer", "description: Root copy."],
+          "Root.",
+        ),
+      });
+
+      const agent = Option.getOrUndefined(
+        yield* getAgentDefinition(AgentId.make("reviewer"), root),
+      );
+
+      assert.equal(agent?.name, "Local reviewer");
+      assert.lengthOf(yield* listAgentSummaries(root), 1);
+    }),
+  );
+
+  it.effect("finds nothing without a workspace root, in an empty one, or for an unknown id", () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const root = yield* fs.makeTempDirectoryScoped({ prefix: "t3-agents-none-" });
+      const emptyRoot = yield* fs.makeTempDirectoryScoped({ prefix: "t3-agents-empty-" });
+      yield* writeFiles(root, {
+        ".agents/reviewer.agent.md": agentFile(
+          ["id: reviewer", "name: Reviewer", "description: Reviews."],
+          "Review.",
+        ),
+      });
+
+      assert.deepEqual(yield* listAgentSummaries(null), []);
+      assert.deepEqual(yield* listAgentSummaries(emptyRoot), []);
+      assert.isTrue(Option.isNone(yield* getAgentDefinition(AgentId.make("reviewer"), null)));
+      assert.isTrue(Option.isNone(yield* getAgentDefinition(AgentId.make("missing"), root)));
+    }),
+  );
+});
+
+describe("resolveModelForAgent", () => {
+  const claude = provider("claudeAgent", "claudeAgent", ["claude-opus-5-5", "claude-haiku-5-5"]);
+  const codex = provider("codex", "codex", ["gpt-5.4"]);
+
+  it("prefers an explicit model in the agent file over its tier", () => {
+    const agent = definition({ tier: "economy", model: { provider: "codex", model: "gpt-5.4" } });
+
+    assert.deepEqual(resolveModelForAgent(agent, [claude, codex]), {
+      instanceId: ProviderInstanceId.make("codex"),
+      model: "gpt-5.4",
+    });
+  });
+
+  it("maps an explicit tier to the driver's available default model", () => {
+    assert.deepEqual(resolveModelForAgent(definition({ tier: "economy" }), [claude]), {
+      instanceId: ProviderInstanceId.make("claudeAgent"),
+      model: "claude-haiku-5-5",
+    });
+    assert.deepEqual(resolveModelForAgent(definition({ tier: "reasoning" }), [claude]), {
+      instanceId: ProviderInstanceId.make("claudeAgent"),
+      model: "claude-opus-5-5",
+    });
+    assert.isUndefined(resolveModelForAgent(definition({}), [claude]));
+  });
+
+  it("picks from the first provider that advertises the tier model", () => {
+    assert.deepEqual(resolveModelForAgent(definition({ tier: "economy" }), [codex, claude]), {
+      instanceId: ProviderInstanceId.make("claudeAgent"),
+      model: "claude-haiku-5-5",
+    });
+  });
+
+  it("returns nothing when no provider advertises the tier model", () => {
+    assert.isUndefined(resolveModelForAgent(definition({ tier: "economy" }), [codex]));
+  });
+
+  it("prefers the current provider instance when it offers the tier model", () => {
+    const firstClaude = provider("claude-first", "claudeAgent", ["claude-haiku-5-5"]);
+    const currentClaude = provider("claude-current", "claudeAgent", ["claude-haiku-5-5"]);
+
+    assert.deepEqual(
+      resolveModelForAgent(
+        definition({ tier: "economy" }),
+        [firstClaude, currentClaude],
+        currentClaude.instanceId,
+      ),
+      { instanceId: currentClaude.instanceId, model: "claude-haiku-5-5" },
+    );
+  });
+
+  it("skips providers that are disabled, unavailable, or missing the fixed model", () => {
+    const disabled = { ...codex, enabled: false };
+    const unavailable = { ...claude, availability: "unavailable" as const };
+    assert.isUndefined(
+      resolveModelForAgent(
+        definition({ model: { instanceId: codex.instanceId, model: "gpt-5.4" } }),
+        [disabled],
+      ),
+    );
+    assert.isUndefined(resolveModelForAgent(definition({ tier: "economy" }), [unavailable]));
+  });
+});
diff --git a/apps/server/src/agent/AgentService.ts b/apps/server/src/agent/AgentService.ts
new file mode 100644
index 0000000000..afff018ca6
--- /dev/null
+++ b/apps/server/src/agent/AgentService.ts
@@ -0,0 +1,210 @@
+/**
+ * AgentService — filesystem discovery of custom agents for thread startup and
+ * delegated tasks. An agent is a markdown file: its YAML
+ * frontmatter holds the `AgentDefinition` fields and its body is the
+ * instructions. Agents come from `.agents/*.md`, then `.github/agents/*.md`,
+ * then the project's `AGENTS.md`, and the first definition of an id wins.
+ *
+ * A file without frontmatter is project guidance rather than an agent, so it
+ * is skipped quietly. Frontmatter that is not a YAML mapping or fails to decode
+ * is skipped with a warning, so one broken file never hides the others.
+ *
+ * @module agent/AgentService
+ */
+import {
+  AgentDefinition,
+  type AgentId,
+  type AgentSummary,
+  DEFAULT_MODEL_BY_PROVIDER,
+  DEFAULT_TEXT_GENERATION_MODEL_BY_PROVIDER,
+  isProviderAvailable,
+  type ModelSelection,
+  type ServerProvider,
+} from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Option from "effect/Option";
+import * as Path from "effect/Path";
+import * as Schema from "effect/Schema";
+import { parse as parseYamlDocument } from "yaml";
+
+const FRONTMATTER_PATTERN = /^---\r?\n([\s\S]*?)\r?\n---(?:\r?\n|$)/;
+
+const decodeAgentDefinition = Schema.decodeUnknownEffect(AgentDefinition);
+
+/** The frontmatter mapping, or undefined when the YAML does not parse to one. */
+function parseFrontmatter(source: string): Record<string, unknown> | undefined {
+  let parsed: unknown;
+  try {
+    parsed = parseYamlDocument(source);
+  } catch {
+    return undefined;
+  }
+  return typeof parsed === "object" && parsed !== null && !Array.isArray(parsed)
+    ? (parsed as Record<string, unknown>)
+    : undefined;
+}
+
+/** Markdown files that may define agents, in precedence order. */
+const listAgentFiles = Effect.fn("listAgentFiles")(function* (workspaceRoot: string) {
+  const fileSystem = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const files: string[] = [];
+  for (const directory of [
+    path.join(workspaceRoot, ".agents"),
+    path.join(workspaceRoot, ".github", "agents"),
+  ]) {
+    const entries = yield* fileSystem
+      .readDirectory(directory)
+      .pipe(Effect.orElseSucceed((): ReadonlyArray<string> => []));
+    for (const entry of [...entries].sort()) {
+      if (entry.endsWith(".md")) {
+        files.push(path.join(directory, entry));
+      }
+    }
+  }
+  return [...files, path.join(workspaceRoot, "AGENTS.md")];
+});
+
+/** The agent a file defines, or undefined when it defines none. */
+const readAgentFile = Effect.fn("readAgentFile")(function* (filePath: string) {
+  const fileSystem = yield* FileSystem.FileSystem;
+  const contents = yield* fileSystem
+    .readFileString(filePath)
+    .pipe(Effect.orElseSucceed(() => undefined));
+  const match = contents === undefined ? null : FRONTMATTER_PATTERN.exec(contents);
+  if (contents === undefined || match === null) {
+    return undefined;
+  }
+  const frontmatter = parseFrontmatter(match[1] ?? "");
+  if (frontmatter === undefined) {
+    yield* Effect.logWarning("agent frontmatter did not parse as a YAML mapping; skipping", {
+      path: filePath,
+    });
+    return undefined;
+  }
+  if (Object.hasOwn(frontmatter, "tools")) {
+    yield* Effect.logWarning("agent tools frontmatter is not supported and was ignored", {
+      path: filePath,
+    });
+  }
+  const instructions = contents.slice(match[0].length).trim();
+  return yield* decodeAgentDefinition({ ...frontmatter, instructions }).pipe(
+    Effect.tapError((cause) =>
+      Effect.logWarning("agent definition is invalid; skipping", { path: filePath, cause }),
+    ),
+    Effect.orElseSucceed(() => undefined),
+  );
+});
+
+/** Every valid agent in a worktree, keeping the first definition of each id. */
+const discoverAgentDefinitions = Effect.fn("discoverAgentDefinitions")(function* (
+  workspaceRoot: string | null,
+) {
+  if (!workspaceRoot) {
+    return [];
+  }
+  const agents = new Map<string, AgentDefinition>();
+  const filePaths = yield* listAgentFiles(workspaceRoot);
+  for (const filePath of filePaths) {
+    const agent = yield* readAgentFile(filePath);
+    if (agent === undefined) {
+      continue;
+    }
+    if (agents.has(agent.id)) {
+      yield* Effect.logWarning("agent id is defined more than once; keeping the first", {
+        id: agent.id,
+        path: filePath,
+      });
+      continue;
+    }
+    agents.set(agent.id, agent);
+  }
+  return [...agents.values()];
+});
+
+export const listAgentDefinitions = discoverAgentDefinitions;
+
+export function summarizeAgentDefinition(agent: AgentDefinition): AgentSummary {
+  return {
+    id: agent.id,
+    name: agent.name,
+    description: agent.description,
+    ...(agent.tier === undefined ? {} : { tier: agent.tier }),
+    ...(agent.model === undefined ? {} : { model: agent.model }),
+  };
+}
+
+/** The roster the composer and `orchestrator_capabilities` advertise. */
+export const listAgentSummaries = Effect.fn("listAgentSummaries")(function* (
+  workspaceRoot: string | null,
+) {
+  const agents = yield* listAgentDefinitions(workspaceRoot);
+  return agents.map(summarizeAgentDefinition);
+});
+
+/** The definition an id names, read from the same locations as `listAgentSummaries`. */
+export const getAgentDefinition = Effect.fn("getAgentDefinition")(function* (
+  agentId: AgentId,
+  workspaceRoot: string | null,
+) {
+  const agents = yield* listAgentDefinitions(workspaceRoot);
+  return Option.fromNullishOr(agents.find((agent) => agent.id === agentId));
+});
+
+/**
+ * The model an agent uses at a thread or delegation boundary. An explicit
+ * `model` in the agent file wins when that exact instance/model is available.
+ * Otherwise an explicit tier picks the first available provider that advertises
+ * its default model, preferring the current instance. An omitted model and tier
+ * leave the child on its selected or inherited model.
+ */
+export function resolveModelForAgent(
+  agent: AgentDefinition,
+  availableProviders: ReadonlyArray<ServerProvider>,
+  preferredInstanceId?: ModelSelection["instanceId"],
+): ModelSelection | undefined {
+  if (agent.model !== undefined) {
+    const provider = availableProviders.find(
+      (candidate) =>
+        candidate.instanceId === agent.model?.instanceId &&
+        canRunAgentModel(candidate) &&
+        candidate.models.some((model) => model.slug === agent.model?.model),
+    );
+    return provider === undefined ? undefined : agent.model;
+  }
+  if (agent.tier === undefined) return undefined;
+  const tierDefaults =
+    agent.tier === "economy"
+      ? DEFAULT_TEXT_GENERATION_MODEL_BY_PROVIDER
+      : DEFAULT_MODEL_BY_PROVIDER;
+  const orderedProviders = availableProviders.toSorted((left, right) => {
+    if (left.instanceId === preferredInstanceId) {
+      return right.instanceId === preferredInstanceId ? 0 : -1;
+    }
+    if (right.instanceId === preferredInstanceId) return 1;
+    return 0;
+  });
+  for (const provider of orderedProviders) {
+    const model = tierDefaults[provider.driver];
+    if (
+      model !== undefined &&
+      canRunAgentModel(provider) &&
+      provider.models.some((candidate) => candidate.slug === model)
+    ) {
+      return { instanceId: provider.instanceId, model };
+    }
+  }
+  return undefined;
+}
+
+function canRunAgentModel(provider: ServerProvider): boolean {
+  return (
+    provider.enabled &&
+    provider.installed &&
+    isProviderAvailable(provider) &&
+    provider.status !== "error" &&
+    provider.status !== "disabled" &&
+    provider.auth.status !== "unauthenticated"
+  );
+}
